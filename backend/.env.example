# Local Development Environment
NODE_ENV=development
PORT=4000

# Database Configuration
DB_DRIVER=sqlite          # sqlite | postgres
BLOB_DRIVER=local         # local | s3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:3000

# Authentication (Local Development)
AUTH_MODE=local           # local | cognito
JWT_SECRET=your-super-secret-jwt-key-change-this

# ========================================
# Production Configuration (Uncomment when deploying)
# ========================================

# NODE_ENV=production
# DB_DRIVER=postgres
# BLOB_DRIVER=s3

# # PostgreSQL
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=jummahcast
# DB_USER=jummahcast_admin
# DB_PASSWORD=your-secure-password
# DB_SSL=true
# DB_POOL_MAX=10

# # AWS S3
# AWS_REGION=eu-west-2
# S3_BUCKET=your-bucket-name
# SIGNED_URL_TTL_SECONDS=300

# # AWS Cognito Authentication
# AUTH_MODE=cognito
# COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
# COGNITO_CLIENT_ID=your-client-id
# COGNITO_REGION=eu-west-2
