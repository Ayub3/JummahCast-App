# Frontend Environment Variables

# API Base URL
# Local development
VITE_API_BASE_URL=http://localhost:4000

# Production (update with your domain)
# VITE_API_BASE_URL=https://api.jummahcast.com

# AWS Cognito (for production authentication)
# VITE_COGNITO_USER_POOL_ID=eu-west-2_XXXXXXXXX
# VITE_COGNITO_CLIENT_ID=your-client-id
# VITE_COGNITO_REGION=eu-west-2
# VITE_COGNITO_DOMAIN=your-app.auth.eu-west-2.amazoncognito.com
